# Google Calendar 연동에 필요한 환경변수. 실제 값은 이 파일에 적지 말고
# Netlify 사이트 설정(Site settings → Environment variables)에 등록한다.
# (로컬 개발용으로만 별도 .env 파일을 만든다면, .env는 절대 커밋하지 않는다.)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console에 등록한 것과 정확히 동일해야 한다. 예:
# https://<your-site>.netlify.app/api/google-auth-callback
GOOGLE_REDIRECT_URI=
